pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins-agent: go-backend-ci-cd
spec:
  containers:
    - name: golang
      image: golang:1.23-alpine
      command: ['cat']
      tty: true
      resources:
        requests:
          cpu: "200m"
          memory: "256Mi"
    - name: docker
      image: docker:27-cli
      command: ['cat']
      tty: true
      volumeMounts:
        - mountPath: /var/run/docker.sock
          name: docker-sock
    - name: kubectl
      image: bitnami/kubectl:latest
      command: ['cat']
      tty: true
      resources:
        requests:
          cpu: "100m"
          memory: "128Mi"
  volumes:
    - name: docker-sock
      hostPath:
        path: /var/run/docker.sock
'''
        }
    }

    environment {
        DOCKER_IMAGE              = 'abhijeetnagar56/go-basic-server'
        DOCKER_CREDENTIALS_ID     = 'docker-hub-credentials'
        KUBECONFIG_CREDENTIALS_ID = 'kubeconfig-credentials'
        K8S_NAMESPACE             = 'go-backend-app'
        K8S_DEPLOYMENT            = 'go-deployment'
        K8S_CONTAINER             = 'go-container'
        APP_DIR                   = 'app'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    stages {
        stage('Checkout & Go Unit Test') {
            steps {
                checkout scm
                script {
                    if (env.GIT_COMMIT) {
                        env.SHORT_SHA = env.GIT_COMMIT.take(7)
                    } else {
                        env.SHORT_SHA = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    }
                    echo "Git Commit Short SHA: ${env.SHORT_SHA}"
                }
                container('golang') {
                    dir("${env.APP_DIR}") {
                        sh '''
                            echo "=== Running Go Unit Tests & Verification ==="
                            go version
                            go vet ./...
                            go test -v -cover ./...
                        '''
                    }
                }
            }
        }

        stage('Docker Build & Tag') {
            steps {
                container('docker') {
                    dir("${env.APP_DIR}") {
                        sh '''
                            echo "=== Building Docker Image ==="
                            SHORT_COMMIT="${SHORT_SHA:-${GIT_COMMIT:0:7}}"
                            echo "Tagging image as ${DOCKER_IMAGE}:${SHORT_COMMIT} and ${DOCKER_IMAGE}:latest"
                            docker build \
                                -t ${DOCKER_IMAGE}:latest \
                                -t ${DOCKER_IMAGE}:${SHORT_COMMIT} \
                                -f dockerfile .
                        '''
                    }
                }
            }
        }

        stage('Docker Push') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(
                        credentialsId: env.DOCKER_CREDENTIALS_ID,
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh '''
                            echo "=== Logging in to Docker Hub ==="
                            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin

                            echo "=== Pushing Docker Images ==="
                            SHORT_COMMIT="${SHORT_SHA:-${GIT_COMMIT:0:7}}"
                            docker push ${DOCKER_IMAGE}:${SHORT_COMMIT}
                            docker push ${DOCKER_IMAGE}:latest
                        '''
                    }
                }
            }
        }

        stage('K8s Deploy') {
            steps {
                container('kubectl') {
                    withCredentials([file(
                        credentialsId: env.KUBECONFIG_CREDENTIALS_ID,
                        variable: 'KUBECONFIG'
                    )]) {
                        sh '''
                            echo "=== Deploying to Kubernetes ==="
                            SHORT_COMMIT="${SHORT_SHA:-${GIT_COMMIT:0:7}}"

                            echo "Setting container image to ${DOCKER_IMAGE}:${SHORT_COMMIT}..."
                            kubectl set image deployment/${K8S_DEPLOYMENT} ${K8S_CONTAINER}=${DOCKER_IMAGE}:${SHORT_COMMIT} -n ${K8S_NAMESPACE}

                            echo "Restarting deployment..."
                            kubectl rollout restart deployment/${K8S_DEPLOYMENT} -n ${K8S_NAMESPACE}

                            echo "Verifying rollout status..."
                            kubectl rollout status deployment/${K8S_DEPLOYMENT} -n ${K8S_NAMESPACE} --timeout=120s

                            echo "=== Deployment Status ==="
                            kubectl get pods,svc,deployment -n ${K8S_NAMESPACE} -l app=go-backend-app -o wide
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline succeeded! Go Backend application tested, packaged, and deployed to Kubernetes."
        }
        failure {
            echo "Pipeline failed. Check stage console logs for troubleshooting."
        }
    }
}
